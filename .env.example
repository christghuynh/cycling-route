# Copy to `.env` and fill in values. `.env` is git-ignored; never commit real keys.

# Required: OpenRouteService API key. It covers routing, elevation, and geocoding.
# Free sign-up (no credit card): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# PostgreSQL (docker compose uses these to create the database)
POSTGRES_USER=cycling
POSTGRES_PASSWORD=cycling
POSTGRES_DB=cycling_routes

# Only needed when running the backend outside Docker
DATABASE_URL=postgresql+asyncpg://cycling:cycling@localhost:5432/cycling_routes

LOG_LEVEL=INFO

# --- Deployment (set these in the hosting provider, not here) ------------------------------
# A hosted database, e.g. Neon. `sslmode` is translated for asyncpg automatically:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Browsers block cross-origin calls, so list the deployed frontend:
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
#
# Serverless deployments should not run schema work on every cold start. Set this to false and
# create the schema once with: cd backend && python -m scripts.init_db
# CREATE_TABLES_ON_STARTUP=false
