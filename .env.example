# Copy to `.env` and fill in values. `.env` is git-ignored; never commit real keys.

# Required: OpenRouteService API key. It covers routing, elevation, geocoding, and autocomplete.
# Free sign-up (no credit card): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# PostgreSQL (docker compose uses these to create the database)
POSTGRES_USER=cycling
POSTGRES_PASSWORD=cycling
POSTGRES_DB=cycling_routes

# Only needed when running the backend outside Docker
DATABASE_URL=postgresql+asyncpg://cycling:cycling@localhost:5432/cycling_routes

LOG_LEVEL=INFO
